; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Tribe Vibes"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://autoload/event_bus.gd"
SaveSystem="*res://autoload/save_system.gd"
GameState="*res://autoload/game_state.gd"
Loc="*res://autoload/loc.gd"
ArtLibrary="*res://autoload/art_library.gd"
InputRouter="*res://autoload/input_router.gd"
Commands="*res://autoload/commands.gd"

[debug]

gdscript/warnings/untyped_declaration=1

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom="res://ui/theme/main_theme.tres"

[importer_defaults]

texture={
"mipmaps/generate": true
}

